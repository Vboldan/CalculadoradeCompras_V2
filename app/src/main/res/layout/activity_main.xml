<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#23272d"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabeçalho com cantos arredondados -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#505c71"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="CALCULADORA DE COMPRAS"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Campo da Data -->
        <TextView
            android:id="@+id/lblData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Campo: Limite Disponível -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Disponível R$:"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/entLimite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#00FFFF"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:nextFocusForward="@+id/entProduto"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Campo: Produto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Produto:"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/entProduto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#00FFFF"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:nextFocusForward="@+id/entPreco"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Campos: Preço e Quantidade -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Preço R$:"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/entPreco"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#00FFFF"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:nextFocusForward="@+id/entQtd"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=" QT: "
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/entQtd"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#00FFFF"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:text="1"
                android:textAlignment="center"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Botões de Ação com MaterialButton -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:elevation="26dp"
                android:maxLines="1"
                android:padding="0dp"
                android:text="Adicionar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#4A4E54"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExc"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:elevation="26dp"
                android:maxLines="1"
                android:padding="0dp"
                android:text="Excluir"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#4A4E54"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:elevation="26dp"
                android:maxLines="1"
                android:padding="0dp"
                android:text="Salvar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#4A4E54"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:elevation="26dp"
                android:enabled="false"
                android:maxLines="1"
                android:padding="0dp"
                android:text="Enviar"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="12sp"
                app:backgroundTint="#4A4E54"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Status -->
        <TextView
            android:id="@+id/lblStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Total: R$0.00 | Restante: R$0.00"
            android:textColor="#2ED156"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Lista de Itens -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#23272d"
            android:minHeight="300dp">

            <LinearLayout
                android:id="@+id/boxLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
