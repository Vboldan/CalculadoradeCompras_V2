<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12161F"
    android:padding="16dp">

    <!-- Cabeçalho e Data -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COMPRAS DE MERCADO"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/lblData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data: 18/10/2026 - 00:00"
        android:textColor="#00FFFF"
        android:textSize="14sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Campo de Limite -->
    <EditText
        android:id="@+id/entLimite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Limite disponível (R$)"
        android:inputType="numberDecimal"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:backgroundTint="#3B88F4"
        android:layout_marginBottom="12dp"
        android:imeOptions="actionNext" />

    <!-- Campos de Entrada de Produto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/entProduto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="Nome do produto"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#3B88F4"
            android:imeOptions="actionNext" />

        <EditText
            android:id="@+id/entPreco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Preço (R$)"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#3B88F4"
            android:imeOptions="actionNext" />

        <EditText
            android:id="@+id/entQtd"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:hint="Qtd"
            android:text="1"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#3B88F4"
            android:imeOptions="actionDone" />
    </LinearLayout>

    <!-- Botões de Ação (Adicionar, Remover, Limpar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnAdicionar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Adicionar"
            android:backgroundTint="#3B88F4"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnRemover"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Excluir"
            android:backgroundTint="#E53E3E"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnLimpar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Limpar"
            android:backgroundTint="#4A5568"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Painel de Status e Item Mais Caro -->
    <TextView
        android:id="@+id/lblStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: R$ 0.00 | Restante: R$ 0.00"
        android:textColor="#00FF00"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/lblItemMaisCaro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mais caro: -"
        android:textColor="#FFA500"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <!-- Lista com Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/boxLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Botões Finais de Salvar PDF e Enviar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Salvar (PDF &amp; CSV)"
            android:backgroundTint="#38A169"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Enviar PDF"
            android:backgroundTint="#3B88F4"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>